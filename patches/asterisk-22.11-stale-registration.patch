+/*! \brief Permit a bounded retry for a replacement Digest nonce, not bad credentials. */
+static int can_retry_stale_challenge(struct registration_response *response)
+{
+	pjsip_hdr_e challenge_type;
+	pjsip_hdr_e authorization_type;
+	pjsip_www_authenticate_hdr *challenge;
+	pjsip_authorization_hdr *authorization;
+
+	if (!response->rdata || !response->client_state->auth_request
+		|| !response->client_state->auth_request->msg || response->retry_after
+		|| response->client_state->stale_auth_retries >= MAX_STALE_AUTH_RETRIES) {
+		return 0;
+	}
+
+	if (response->code == 401) {
+		challenge_type = PJSIP_H_WWW_AUTHENTICATE;
+		authorization_type = PJSIP_H_AUTHORIZATION;
+	} else if (response->code == 407) {
+		challenge_type = PJSIP_H_PROXY_AUTHENTICATE;
+		authorization_type = PJSIP_H_PROXY_AUTHORIZATION;
+	} else {
+		return 0;
+	}
+
+	for (challenge = pjsip_msg_find_hdr(response->rdata->msg_info.msg, challenge_type, NULL);
+		challenge;
+		challenge = pjsip_msg_find_hdr(response->rdata->msg_info.msg, challenge_type, challenge->next)) {
+		if (pj_stricmp2(&challenge->scheme, "Digest")
+			|| !challenge->challenge.digest.stale || !challenge->challenge.digest.nonce.slen) {
+			continue;
+		}
+		for (authorization = pjsip_msg_find_hdr(response->client_state->auth_request->msg, authorization_type, NULL);
+			authorization;
+			authorization = pjsip_msg_find_hdr(response->client_state->auth_request->msg, authorization_type, authorization->next)) {
+			if (!pj_stricmp2(&authorization->scheme, "Digest")
+				&& authorization->credential.digest.response.slen
+				&& authorization->credential.digest.nonce.slen
+				&& !pj_strcmp(&authorization->credential.digest.realm, &challenge->challenge.digest.realm)
+				&& pj_strcmp(&authorization->credential.digest.nonce, &challenge->challenge.digest.nonce)) {
+				return 1;
+			}
+		}
+	}
+	return 0;
+}
